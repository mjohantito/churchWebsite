# Copy to .env.local (local dev) and set the same names in Vercel → Settings → Environment Variables.
# These are PUBLIC values: Vite puts them in the browser bundle. RLS protects the data.
# NEVER add the service_role / sb_secret_ key to any VITE_ variable, to Vercel env, or to git.

# Required
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional
# Public site URL for canonical links, og:url and sitemap.xml (e.g. https://setiabakti.org).
# On Vercel the production URL is used automatically when this is empty.
VITE_SITE_URL=
# Offline demo mode with mock data. Leave empty/false in production.
VITE_USE_MOCK=
